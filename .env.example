# Copy to .env and fill in. Everything has a default that at least starts.
#
#   cp .env.example .env
#   export GIT_TOKEN=ghp_...        # the week repos are private
#   make up                         # or: ./scripts/stack.sh up
#                                   # or: .\scripts\stack.ps1 up   (Windows)

# --- Cloning the four weeks ----------------------------------------------
# Every service builds its week from GitHub at the ref pinned here; this repo
# holds no second copy of any of them. `make refs` prints what each running
# container was actually built from.
#
# All four repositories are PRIVATE, so the Docker daemon needs a credential to
# read them. Set GIT_TOKEN in the shell (or here) and compose hands it to the
# builds as a BuildKit secret - mounted for the one RUN that clones, never
# written into a layer and never visible in `docker history`. A token with
# `repo:read` is enough. Once the repositories are public, delete it.
GIT_TOKEN=

# Week 1 - the knowledge base (retrieval).
WEEK1_REPO=https://github.com/a-3isa/week1-ai-regulation-pipeline.git
WEEK1_BRANCH=week1-ai-regulation-pipeline
WEEK1_REF=d8e6637e8dbfeee809152d6133292a54538a8188

# Week 2 - the agent framework.
# Week 3 VENDORS Week 2 at src/vendor/week2, so cloning Week 3 already brings
# the personas, the LLM client and the tools. Leave WEEK2_OVERLAY=0 to use that
# vendored copy, which is the one Week 3 was tested against. Set it to 1 to
# clone Week 2 separately and replace that directory - useful when Week 2 has
# moved on and you want the new one without waiting for Week 3 to re-vendor it.
WEEK2_OVERLAY=0
WEEK2_REPO=https://github.com/a-3isa/Intelligent-Agent-Framework.git
WEEK2_BRANCH=main
WEEK2_REF=

# Week 3 - the discussion engine.
WEEK3_REPO=https://github.com/a-3isa/Multi-Agent-Collaboration-AI-Regulation-Team_A.git
WEEK3_BRANCH=week3-task-scaffold
WEEK3_REF=93af9b3cb2219351cc888cf97f5769b71889eb3b

# Week 4 - the analytics engine. An empty WEEK4_REF tracks the branch head.
# Pinned to the branch carrying the fixes this app depends on: one colour per
# agent (shared with frontend/src/agentColors.js), the influence score back to
# its documented magnitude-only contract, and `influence_detail` in the result,
# which the dashboard's influence table reads. On main, the influence bar can
# go negative and the report has no closing exchange.
WEEK4_REPO=https://github.com/YaassminSalahEldin/Analytics-Intelligence-Layer.git
WEEK4_BRANCH=week5/production-followups
WEEK4_REF=bfbdb451d4043ad5f0c1a0c02012164ab5dc0e33

# --- Public routing (Traefik) --------------------------------------------
# Hostname Traefik should route to this stack.
PUBLIC_HOST=example.com
# Origin the browser uses; the APIs allow it via CORS.
PUBLIC_ORIGIN=https://example.com
# Base URL the UI calls. Baked into the bundle at build time by Vite, so
# rebuild the ui image when this changes.
VITE_API_BASE=https://example.com/api
# Docker network Traefik watches, and its ACME resolver name.
TRAEFIK_NETWORK=platform_edge
CERT_RESOLVER=letsencrypt

# --- The model that writes the arguments ---------------------------------
# Without a key every turn falls back to a deterministic stub and the UI says
# so. The model must support tool calling - the agents choose when to retrieve.
OPENROUTER_API_KEY=
#
# CHOOSING A MODEL, AND WHY THIS ONE
# A debate is one or two model calls per agent per round, in series, so the
# model's latency IS the app's latency. The previous default,
# meta-llama/llama-3.3-70b-instruct, is a fine writer and a slow one: a
# 70-billion-parameter dense model generating 700 tokens per turn is the
# difference between a demo that feels live and one that feels broken.
#
# google/gemini-2.5-flash is the default because it is markedly faster per
# token, supports tool calling, and writes policy argument at least as well at
# this length. Alternatives worth trying, all tool-capable:
#
#   openai/gpt-4.1-mini            fast, very steady at instruction-following
#   anthropic/claude-haiku-4.5     fast, strong at holding a persona
#   google/gemini-2.5-flash-lite   fastest here; noticeably shallower arguments
#   meta-llama/llama-3.3-70b-instruct   the old default, if you preferred it
#
# Check the exact slug at https://openrouter.ai/models before changing it: a
# wrong slug fails every turn with a 400 and the UI shows stub text.
OPENROUTER_MODEL=google/gemini-2.5-flash
# 1 = never call the LLM (free, offline, deterministic placeholder turns).
AGENT_LLM_STUB=0

# --- Latency -------------------------------------------------------------
# How many opening positions to generate at once. Round 0 is independent per
# agent, so this is nearly free speed; too high and the provider answers with
# 429s and the retry backoff makes it slower than serial.
DEBATE_SEED_CONCURRENCY=4
#
# Run a round's turns concurrently. OFF by default, and not only for safety:
# it changes the debate. Sequentially, an agent reads the previous round in
# full plus this round so far, so the second speaker can answer the first.
# In parallel everyone sees only the previous round - roughly N times faster,
# and a shallower conversation. `config.parallel_turns` on every discussion
# records which one produced it.
DEBATE_PARALLEL_TURNS=0
#
# Shortest gap between two writes of a run's record, in seconds. Each write
# serialises the whole event log, so writing on every event made a long debate
# quadratic in its own length. 0 restores write-on-every-event.
DEBATE_SAVE_INTERVAL=2.0

# --- Week 1 knowledge base (retrieval during the debate) ------------------
# What the AGENTS call. The default is the hosted deployment; point it at the
# knowledge service in this stack to serve retrieval from here instead.
#   WEEK1_RETRIEVAL_URL=http://knowledge:8200
WEEK1_RETRIEVAL_URL=https://ai-regulation-rag.vercel.app
WEEK1_API_KEY=
RAG_TIMEOUT_SECONDS=30

# --- Self-hosted Week 1: the corpus database -----------------------------
# The knowledge service runs as part of the default stack and talks to the `db`
# service (Postgres + pgvector) below. It needs the embedded corpus in that
# database, and the same embedding model AND dimensions the corpus was built
# with - a query vector of any other size fails with "different vector
# dimensions". Take both values from the Week 1 .env that built the corpus; do
# not trust the Week 1 repo's example (it says 2000, the deployed corpus is
# 512). Until the corpus is loaded, searches answer with an error naming what
# is missing rather than returning nothing and looking like a result.
WEEK1_DATABASE_URL=postgresql://week1:week1@db:5432/week1
OPENAI_API_KEY=
WEEK1_EMBEDDING_MODEL=text-embedding-3-large
WEEK1_EMBEDDING_DIMENSIONS=512
WEEK1_TOP_K=5
# Credentials for the bundled database. Change them for anything public: the
# port is only published by the local overlay, but the defaults are guessable.
POSTGRES_USER=week1
POSTGRES_PASSWORD=week1
POSTGRES_DB=week1

# --- Logging --------------------------------------------------------------
# The debate service logs one timestamped line per request and per debate event
# (created, retrieved, cancelled, completed, failed, analytics, report, member
# edits), each carrying the run id:
#
#   2026-09-21 10:15:32 INFO  discussion_created run_id=abc123 rounds=5 topic="..."
#   2026-09-21 10:16:07 ERROR analytics_failed run_id=abc123 reason="..."
#
# Read them with `make logs`, or `docker compose logs debate | grep run_id=abc123`
# for one debate end to end. DEBUG also turns on the libraries' own logging.
LOG_LEVEL=INFO

# --- Limits ---------------------------------------------------------------
# A debate costs one LLM call per agent per round, so both of these bound how
# much one careless request can spend.
DEBATE_MAX_ROUNDS=8
DEBATE_MAX_CONCURRENT_RUNS=2

# --- Sentiment backend ----------------------------------------------------
# vader (small, deterministic) or transformer (~2.5GB image, needs >2GB RAM).
SENTIMENT_BACKEND=vader
