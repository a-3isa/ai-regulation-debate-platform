# --- Public routing (Traefik) --------------------------------------------
# Hostname Traefik should route to this stack.
PUBLIC_HOST=example.com
# Origin the browser uses; the APIs allow it via CORS.
PUBLIC_ORIGIN=https://example.com
# Base URL the UI calls. Baked into the bundle at build time by Vite, so
# rebuild the ui image when this changes.
VITE_API_BASE=https://example.com/api
# Docker network Traefik watches, and its ACME resolver name.
TRAEFIK_NETWORK=platform_edge
CERT_RESOLVER=letsencrypt

# --- Week 2 LLM provider (agent turns) ------------------------------------
# Without a key every turn falls back to a deterministic stub and the UI says
# so. The model must support tool calling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# 1 = never call the LLM (free, offline, deterministic placeholder turns).
AGENT_LLM_STUB=0

# --- Week 1 knowledge base (retrieval during the debate) ------------------
# Point this at the Vercel deployment, or at the self-hosted service below
# (http://knowledge:8200). WEEK1_API_KEY gates both.
WEEK1_RETRIEVAL_URL=https://ai-regulation-rag.vercel.app
WEEK1_API_KEY=
RAG_TIMEOUT_SECONDS=30

# --- Self-hosting Week 1 instead of Vercel (optional) ---------------------
#   docker compose --profile selfhosted-week1 up -d --build
#   WEEK1_RETRIEVAL_URL=http://knowledge:8200
# Needs the pgvector database holding the embedded corpus, and the same
# embedding model AND dimensions it was built with - a query vector of any other
# size fails with "different vector dimensions". Take both values from the
# Week 1 .env that built the corpus; do not trust the Week 1 repo's example
# (it says 2000, the deployed corpus is 512).
WEEK1_DATABASE_URL=
OPENAI_API_KEY=
WEEK1_EMBEDDING_MODEL=text-embedding-3-large
WEEK1_EMBEDDING_DIMENSIONS=512
COMPOSE_PROFILES=
WEEK1_TOP_K=5

# --- Limits ---------------------------------------------------------------
# A debate costs one LLM call per agent per round, so both of these bound
# how much one careless request can spend.
DEBATE_MAX_ROUNDS=8
DEBATE_MAX_CONCURRENT_RUNS=2

# --- Sentiment backend ----------------------------------------------------
# vader (small, deterministic) or transformer (~2.5GB image, needs >2GB RAM).
SENTIMENT_BACKEND=vader

# --- Week 4 analytics source ---------------------------------------------
# Build context for the analytics service: a git URL pinned to a ref.
ANALYTICS_REPO=https://github.com/YaassminSalahEldin/Analytics-Intelligence-Layer.git#fix/week4-review-followups
